<?xml version="1.0" encoding="UTF-8"?>
<!--
    Pure PHP unit tests: no WordPress, no WooCommerce, no Odoo.
    WP/WC functions are stubbed and Odoo is an in-memory fake (tests/pure/).
    Run: vendor/bin/phpunit -c phpunit-pure.xml
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="tests/pure/bootstrap.php"
         cacheResultFile=".phpunit.cache/pure-results"
         colors="false"
         verbose="true">
    <testsuites>
        <testsuite name="pure">
            <file>tests/test-test-orders-patterns.php</file>
            <directory suffix="Test.php">tests/pure</directory>
        </testsuite>
    </testsuites>
</phpunit>
